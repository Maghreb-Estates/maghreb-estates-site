---
// Herbruikbare listing-/projectcard. Data-gedreven vanuit projecten.ts +
// projectenVertaling.ts, taal-bewust. De hele card is één link.
//
// Beeld via astro:assets: automatische webp + srcset, met een vaste
// beeldverhouding (16:10) in een overflow-container zodat er geen layout shift
// optreedt, ook al verschillen de bronafmetingen per project.
import { Image } from 'astro:assets';
import { type Project } from '../data/projecten';
import { projectContent } from '../data/projectenVertaling';
import { standaardTaal, type Taal } from '../i18n/config';
import { aanbodUi, aanbodProjectPad } from '../i18n/aanbod';

interface Props {
  project: Project;
  taal?: Taal;
  /** Kopregelniveau binnen de paginahiërarchie (2 op overzicht, 3 in lijstjes). */
  headingLevel?: 2 | 3;
  /** sizes-attribuut voor srcset; standaard 2 koloms desktop, vol op mobiel. */
  sizes?: string;
  /** Alleen de eerste card boven de vouw is niet-lazy (betere LCP). */
  eager?: boolean;
}

const { project: p, taal = standaardTaal, headingLevel = 3, sizes = '(max-width: 760px) 100vw, 380px', eager = false } = Astro.props;
const ui = aanbodUi[taal];
const c = projectContent(p, taal);
const Titel = `h${headingLevel}` as 'h2' | 'h3';
const pad = aanbodProjectPad(taal, p.stad, p.slug);
const locatie = p.wijk ? `${p.stadNaam} · ${p.wijk}` : p.stadNaam;
const prijs = c.prijsVanafTekst ?? ui.prijsOpAanvraag;
---
<article class="property-card">
  <a class="property-card__link" href={pad} aria-label={`${p.naam} — ${locatie}`}>
    <div class="property-card__media">
      <Image
        src={p.thumb.src}
        alt={p.thumb.alt}
        widths={[400, 600, 800]}
        sizes={sizes}
        class="property-card__img"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    </div>
    <div class="property-card__body">
      <p class="property-card__loc">{locatie}, {ui.land}</p>
      <Titel class="property-card__title">{p.naam}</Titel>
      <p class="property-card__desc">{c.kort}</p>
      <div class="property-card__foot">
        <span class="property-card__prijs">{prijs}</span>
        <span class="property-card__cta">{ui.bekijkProject}</span>
      </div>
    </div>
  </a>
</article>
