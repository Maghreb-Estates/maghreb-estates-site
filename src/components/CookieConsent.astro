---
// Cookiemelding + Google Analytics 4 + Microsoft Clarity + meting van contactmomenten.
//
// AVG/cookiewet: Analytics en Clarity worden pas geladen NA een klik op "Akkoord" (Consent
// Mode, basic). Zonder keuze of na "Weigeren" gaat er niets naar Google.
// "Weigeren" is bewust even groot en zichtbaar als "Akkoord" (eis van de AP).
// De keuze wordt 6 maanden onthouden; via "Cookie-instellingen" in de footer
// (data-cookie-instellingen) is hij altijd te wijzigen.
//
// Contactmomenten (zichtbaar in GA4 → Rapporten → Betrokkenheid → Gebeurtenissen):
//   contact_click  — klik op een WhatsApp-, telefoon- of e-maillink (method, location)
//   generate_lead  — een formulier is verzonden (form, method); aangeroepen vanuit
//                    de formulierscripts via window.meTrack(...)
import { site } from '../data/site';
import { standaardTaal, type Taal } from '../i18n/config';

interface Props { taal?: Taal }
const { taal = standaardTaal } = Astro.props;

// Het privacybeleid bestaat alleen in het Nederlands; anderstalige bezoekers
// krijgen daarom een taallabel achter de link (zelfde aanpak als de footer).
const teksten: Record<Taal, { titel: string; tekst: string; link: string; label: string; weigeren: string; akkoord: string }> = {
  nl: {
    titel: 'Wij respecteren uw privacy',
    tekst: 'Met uw toestemming gebruiken wij cookies om te meten hoe onze website wordt gebruikt, zodat we hem kunnen verbeteren. Meer informatie leest u in ons',
    link: 'privacybeleid', label: '', weigeren: 'Weigeren', akkoord: 'Akkoord',
  },
  en: {
    titel: 'We value your privacy',
    tekst: 'With your consent, we use cookies to measure how our website is used so we can improve it. Please see our',
    link: 'Privacy Policy', label: ' (in Dutch)', weigeren: 'Decline', akkoord: 'Accept',
  },
  fr: {
    titel: 'Nous respectons votre vie privée',
    tekst: 'Avec votre accord, nous utilisons des cookies pour mesurer l’utilisation de notre site afin de l’améliorer. Pour en savoir plus, consultez notre',
    link: 'politique de confidentialité', label: ' (en néerlandais)', weigeren: 'Refuser', akkoord: 'Accepter',
  },
  ar: {
    titel: 'نحن نحترم خصوصيتك',
    tekst: 'بموافقتك، نستخدم ملفات تعريف الارتباط لقياس كيفية استخدام موقعنا من أجل تحسينه. لمزيد من المعلومات، اطّلع على',
    link: 'سياسة الخصوصية', label: ' (بالهولندية)', weigeren: 'رفض', akkoord: 'موافق',
  },
};
const t = teksten[taal];
---
<div class="cookiebar" id="cookiebar" role="region" aria-label="Cookies" hidden>
  <div class="cookiebar__tekst">
    <p class="cookiebar__titel">{t.titel}</p>
    <p>{t.tekst} <a href="/privacybeleid/#cookies">{t.link}</a>{t.label}.</p>
  </div>
  <div class="cookiebar__knoppen">
    <button type="button" class="btn btn--outline cookiebar__knop" data-cookie="denied">{t.weigeren}</button>
    <button type="button" class="btn btn--primary cookiebar__knop" data-cookie="granted">{t.akkoord}</button>
  </div>
</div>

<script is:inline define:vars={{ gaId: site.gaId, clarityId: site.clarityId }}>
  (function () {
    var SLEUTEL = 'me_consent';
    var GELDIG_MS = 182 * 24 * 60 * 60 * 1000; // ±6 maanden
    var bar = document.getElementById('cookiebar');

    function leesKeuze() {
      try {
        var k = JSON.parse(localStorage.getItem(SLEUTEL) || 'null');
        if (k && (k.s === 'granted' || k.s === 'denied') && Date.now() - k.t < GELDIG_MS) return k.s;
      } catch (e) {}
      return null;
    }
    function bewaarKeuze(s) {
      try { localStorage.setItem(SLEUTEL, JSON.stringify({ s: s, t: Date.now() })); } catch (e) {}
    }

    function laadAnalytics() {
      if (window.__meGa) return;
      window.__meGa = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
      });
      window.gtag('js', new Date());
      window.gtag('config', gaId);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    }

    // Microsoft Clarity (heatmaps + opnames). Zelfde toestemming als Analytics;
    // ingevulde tekst wordt gemaskeerd (instelling "Strict" in het Clarity-dashboard).
    function laadClarity() {
      if (window.__meClarity || !clarityId) return;
      window.__meClarity = true;
      window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
      window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.clarity.ms/tag/' + clarityId;
      document.head.appendChild(s);
    }

    // Bij intrekken: Analytics en Clarity stoppen en hun cookies opruimen.
    function stopAnalytics() {
      if (window.__meGa && window.gtag) window.gtag('consent', 'update', { analytics_storage: 'denied' });
      if (window.__meClarity && window.clarity) window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
      document.cookie.split(';').forEach(function (c) {
        var naam = c.split('=')[0].trim();
        if (!/^(_ga|_gid|_clck|_clsk)/.test(naam)) return;
        var verlopen = '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        document.cookie = naam + verlopen;
        document.cookie = naam + verlopen + '; domain=.' + location.hostname.replace(/^www\./, '');
      });
    }

    function kies(s) {
      bewaarKeuze(s);
      bar.hidden = true;
      if (s === 'granted') { laadAnalytics(); laadClarity(); } else stopAnalytics();
    }

    // Eén centrale meetfunctie voor de hele site; doet niets zonder toestemming.
    window.meTrack = function (naam, params) {
      if (window.__meGa && window.gtag) window.gtag('event', naam, params || {});
      // In Clarity kun je hierop filteren: "toon opnames waarin een lead binnenkwam".
      if (window.__meClarity && window.clarity) window.clarity('event', naam);
    };

    var keuze = leesKeuze();
    if (keuze === 'granted') { laadAnalytics(); laadClarity(); }
    // Pas tonen als de webfonts binnen zijn. De melding staat onderaan vast: wisselt
    // het lettertype terwijl hij al zichtbaar is, dan verandert zijn hoogte en
    // verspringt hij (layout shift, CLS).
    else if (keuze === null) {
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(function () { bar.hidden = false; });
    }

    document.addEventListener('click', function (e) {
      var knop = e.target.closest('[data-cookie]');
      if (knop) { kies(knop.getAttribute('data-cookie')); return; }

      if (e.target.closest('[data-cookie-instellingen]')) {
        e.preventDefault();
        bar.hidden = false;
        return;
      }

      // Klik op een WhatsApp-, telefoon- of e-maillink = contactmoment.
      var a = e.target.closest('a[href]');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      var methode = href.indexOf('https://wa.me/') === 0 ? 'whatsapp'
        : href.indexOf('tel:') === 0 ? 'telefoon'
        : href.indexOf('mailto:') === 0 ? 'email'
        : null;
      if (!methode) return;
      var plek = a.closest('.sticky-wa') ? 'sticky'
        : a.closest('footer') ? 'footer'
        : a.closest('nav, header') ? 'navigatie'
        : 'pagina';
      window.meTrack('contact_click', { method: methode, location: plek });
    });
  })();
</script>

<style>
  .cookiebar {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 100;
    max-width: 760px; margin: 0 auto;
    display: flex; align-items: center; gap: 18px 24px;
    background: var(--cream); color: var(--text);
    border: 1px solid var(--border); border-radius: 6px;
    box-shadow: var(--shadow);
    padding: 16px 20px;
    font-family: var(--font-sans); font-size: 14.5px; line-height: 1.5;
  }
  .cookiebar[hidden] { display: none; }
  .cookiebar__tekst { flex: 1; }
  .cookiebar__tekst p { margin: 0; }
  .cookiebar__tekst .cookiebar__titel { font-family: var(--font-serif); font-size: 19px; font-weight: 600; line-height: 1.2; margin-bottom: 4px; }
  .cookiebar__tekst a { color: var(--green-mid); text-decoration: underline; text-underline-offset: 3px; }
  .cookiebar__knoppen { display: flex; gap: 10px; flex-shrink: 0; }
  /* Weigeren en Akkoord bewust even groot. */
  .cookiebar__knop { min-width: 112px; text-align: center; padding: 10px 22px; }
  @media (max-width: 640px) {
    .cookiebar { flex-direction: column; align-items: stretch; left: 10px; right: 10px; bottom: 10px; padding: 14px 16px; font-size: 14px; }
    .cookiebar__knoppen > * { flex: 1; }
  }
</style>
