---
// Verkooppagina in alle vier de talen: eigenaren melden hier hun woning aan en
// wij nemen de verkoop volledig uit handen. Doelgroep: eigenaren in Marokko
// zelf én Marokkanen in het buitenland. Het formulier staat bewust direct
// onder de hero.
//
// Tekst per taal: src/i18n/verkopen.ts. Gebruikt door
// src/pages/huis-verkopen-marokko.astro (NL) en src/pages/[lang]/[slug].astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import ProjectGallery from './ProjectGallery.astro';
import VerderLezen from './VerderLezen.astro';
import { site, waLink } from '../data/site';
import type { ProjectFoto } from '../data/projecten';
import { faqSchema, serviceSchema } from '../data/schema';
import marktprijzen from '../data/marktprijzen.json';
import heroFoto from '../assets/verkopen/hero.webp';
import { paginas, standaardTaal, type Taal } from '../i18n/config';
import { ui } from '../i18n/ui';
import { verkoopTekst, verkoopcase, werkgebied, type WerkgebiedStad } from '../i18n/verkopen';

interface Props { taal?: Taal }
const { taal = standaardTaal } = Astro.props;
const t = verkoopTekst[taal];
const p = t.prijzen;
const pad = paginas.verkopen[taal];
const isNl = taal === standaardTaal;

const opsomming = (namen: string[], voegwoord: string) =>
  `${namen.slice(0, -1).join(t.lijst.komma)}${voegwoord}${namen[namen.length - 1]}`;
const stadNamen = werkgebied.map((s) => t.steden[s]);
const steden = opsomming(stadNamen, t.lijst.en);
const stedenOf = opsomming(stadNamen, t.lijst.of);
const vul = (s: string) => s.replaceAll('{steden}', steden).replaceAll('{stedenOf}', stedenOf);

// Op de Franse en Arabische pagina is het +212-nummer (site.ts) het belnummer:
// daar zitten de verkopers in Marokko zelf. WhatsApp blijft het NL-nummer.
const lokaal = (taal === 'fr' || taal === 'ar') && site.telefoonMA !== '';
const tel = lokaal
  ? { nummer: site.telefoonMA, href: site.telefoonMAHref }
  : { nummer: site.telefoon, href: site.telefoonHref };
const waBericht = waLink(t.aanmelden.waBericht);

// Vraagprijzen per m² (scripts/marktprijzen.py → src/data/marktprijzen.json).
const locale = { nl: 'nl-NL', en: 'en-GB', fr: 'fr-FR', ar: 'ar-MA' }[taal];
const getal = (n: number) => new Intl.NumberFormat(locale).format(n);
const datum = (iso: string) =>
  new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
const m2 = (n: number) => `${getal(n)} ${p.eenheid}`;
const wijkNaam = (naam: string) => t.wijkNamen?.[naam] ?? naam;
const prijsSteden = marktprijzen.steden.map((s) => ({ ...s, naam: t.steden[s.stad as WerkgebiedStad] }));
const prijsRijen = prijsSteden.flatMap((s) =>
  (['appartement', 'villa'] as const).flatMap((type) => {
    const r = s.types[type];
    return r ? [{ stad: s.naam, type: p.types[type], ...r }] : [];
  }),
);
const wijkRijen = prijsSteden.flatMap((s) => s.wijken.map((w) => ({ ...w, naam: wijkNaam(w.naam), stad: s.naam })));
const vulPrijs = (s: string) => s
  .replaceAll('{datum}', datum(marktprijzen.bijgewerkt))
  .replaceAll('{van}', datum(marktprijzen.periode.van))
  .replaceAll('{n}', getal(marktprijzen.advertenties))
  .replaceAll('{min}', getal(marktprijzen.minWijk))
  .replaceAll('{bronnen}', opsomming(marktprijzen.bronnen, t.lijst.en))
  .replaceAll('{prijzen}', opsomming(
    prijsSteden.filter((s) => s.types.appartement).map((s) =>
      p.inStad.replace('{prijs}', m2(s.types.appartement!.mediaan)).replace('{stad}', s.naam)),
    t.lijst.en,
  ));

// De prijsvraag staat als derde FAQ, met de actuele cijfers.
const faqs = [...t.faqs.slice(0, 2), p.faq, ...t.faqs.slice(2)].map((f) => ({ q: f.q, a: vulPrijs(vul(f.a)) }));

// Case-foto's verschijnen vanzelf: zie src/assets/verkopen/case/LEESMIJ.md.
// De bestandsnaam bepaalt de volgorde en de alt-tekst.
const fotoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/verkopen/case/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const altUitBestand = (bestand: string, i: number) => {
  const naam = bestand.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/^[\d\s._-]+/, '').replace(/[-_]+/g, ' ').trim();
  return naam ? naam.charAt(0).toUpperCase() + naam.slice(1) : `${t.case.titel}, ${i + 1}`;
};
const caseFotos: ProjectFoto[] = Object.keys(fotoModules)
  .sort()
  .map((bestand, i) => ({ src: fotoModules[bestand].default, alt: altUitBestand(bestand, i) }));
---
<BaseLayout
  title={t.meta.title}
  description={vul(t.meta.description)}
  path={pad}
  taal={taal}
  schema={[
    faqSchema(faqs),
    serviceSchema({ naam: t.meta.dienst, beschrijving: vul(t.meta.dienstBeschrijving), path: pad, steden: werkgebied, type: t.meta.dienst }),
  ]}
>
  {/* Beide knoppen openen het formulier; het script vult "Uw vraag" in. */}
  <Hero
    compact
    eyebrow={t.hero.eyebrow}
    title={t.hero.titel}
    sub={vul(t.hero.sub)}
    image={heroFoto}
    ctas={[
      { label: t.hero.estimatie, href: '#aanmelden', primary: true },
      { label: t.hero.aanbieden, href: '#aanmelden' },
    ]}
    trust={t.hero.trust}
  />
  <Breadcrumbs
    items={[{ label: t.kruimel, href: pad }]}
    home={{ label: ui[taal].breadcrumb.home, href: paginas.home[taal] }}
  />

  <!-- AANMELDEN: direct na de hero, met het werkgebied ernaast -->
  <section class="section" id="aanmelden" style="padding-top:40px">
    <div class="container">
      <!-- Op mobiel: intro, dan meteen het formulier, daarna werkgebied en voordelen. -->
      <div class="aanmeld">
        <div class="aanmeld__kop">
          <p class="eyebrow">{t.aanmelden.eyebrow}</p>
          <h2>{t.aanmelden.titel}</h2>
          <p class="section__desc">{t.aanmelden.intro}</p>
        </div>

        <div class="aanmeld__info">
          <div class="werkgebied">
            <h3>{t.aanmelden.werkgebiedTitel}</h3>
            <p>{t.aanmelden.werkgebiedTekst}</p>
            <ul class="werkgebied__lijst">
              {werkgebied.map((s) => (
                <li><Icon name="afstand" size={17} /><span>{t.steden[s]}</span></li>
              ))}
            </ul>
          </div>

          <ul class="checks" style="margin-bottom:22px">
            {t.aanmelden.voordelen.map((v) => <li>{v}</li>)}
          </ul>

          <p class="werkgebied__direct">{t.aanmelden.direct} <a href={waBericht}>{t.aanmelden.directWa}</a> {t.aanmelden.directBel} <a href={`tel:${tel.href}`} dir="ltr">{tel.nummer}</a>.</p>
          {lokaal && (
            <p class="werkgebied__direct">{t.aanmelden.internationaal} <a href={`tel:${site.telefoonHref}`} dir="ltr">{site.telefoon}</a></p>
          )}
        </div>

        <form class="card aanmeld__form" id="verkoopForm" novalidate>
          <div class="veld">
            <label for="doel">{t.form.doel}</label>
            <select id="doel" name="doel">
              <option value="">{t.form.kies}</option>
              {t.form.doelen.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="veld">
            <label for="naam">{t.form.naam} <span aria-hidden="true">*</span></label>
            <input type="text" id="naam" name="naam" placeholder={t.form.naamPh} required />
          </div>
          <div class="veld">
            <label for="telefoon">{t.form.telefoon} <span aria-hidden="true">*</span></label>
            <input type="tel" id="telefoon" name="telefoon" placeholder={t.form.telefoonPh} dir="ltr" required />
          </div>
          <div class="veld">
            <label for="email">{t.form.email} <span class="veld__hint">{t.form.optioneel}</span></label>
            <input type="email" id="email" name="email" placeholder={t.form.emailPh} dir="ltr" />
          </div>
          <div class="veld">
            <label for="stad">{t.form.stad} <span aria-hidden="true">*</span></label>
            <select id="stad" name="stad" required>
              <option value="">{t.form.stadKies}</option>
              {werkgebied.map((s) => <option value={s}>{t.form.stadOptie.replace('{stad}', t.steden[s])}</option>)}
            </select>
          </div>
          <div class="veld">
            <label for="wijk">{t.form.wijk} <span class="veld__hint">{t.form.optioneel}</span></label>
            <input type="text" id="wijk" name="wijk" placeholder={t.form.wijkPh} />
          </div>
          <div class="veld-rij">
            <div class="veld">
              <label for="type">{t.form.type} <span aria-hidden="true">*</span></label>
              <select id="type" name="type" required>
                <option value="">{t.form.kies}</option>
                {t.form.types.map((o) => <option>{o}</option>)}
              </select>
            </div>
            <div class="veld">
              <label for="woonplaats">{t.form.woont} <span aria-hidden="true">*</span></label>
              <select id="woonplaats" name="woonplaats" required>
                <option value="">{t.form.kies}</option>
                {t.form.woonOpties.map((o) => <option>{o}</option>)}
              </select>
            </div>
          </div>
          <div class="veld-rij">
            <div class="veld">
              <label for="oppervlak">{t.form.oppervlak} <span class="veld__hint">{t.form.oppervlakHint}</span></label>
              <input type="text" id="oppervlak" name="oppervlak" inputmode="numeric" placeholder={t.form.oppervlakPh} />
            </div>
            <div class="veld">
              <label for="kamers">{t.form.kamers}</label>
              <input type="text" id="kamers" name="kamers" inputmode="numeric" placeholder={t.form.kamersPh} />
            </div>
          </div>
          <div class="veld">
            <label for="titel">{t.form.titel} <span class="veld__hint">{t.form.optioneel}</span></label>
            <select id="titel" name="titel">
              <option value="">{t.form.titelOnbekend}</option>
              {t.form.titels.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="veld">
            <label for="prijs">{t.form.prijs} <span class="veld__hint">{t.form.optioneel}</span></label>
            <input type="text" id="prijs" name="prijs" placeholder={t.form.prijsPh} />
          </div>
          <div class="veld">
            <label for="bericht">{t.form.bericht} <span class="veld__hint">{t.form.optioneel}</span></label>
            <textarea id="bericht" name="bericht" rows="3" placeholder={t.form.berichtPh}></textarea>
          </div>

          <div class="form__acties">
            <button type="button" id="sendWhatsapp" class="btn btn--primary">{t.form.viaWhatsapp}</button>
            <button type="button" id="sendMail" class="btn btn--outline">{t.form.viaEmail}</button>
          </div>

          <p class="form__melding" id="bevestiging" hidden>{t.form.bevestiging}</p>
        </form>
      </div>
    </div>
  </section>

  <!-- PRIJZEN: eigen marktdata als gewone HTML-tabel, zodat zoekmachines en
       AI-assistenten de cijfers kunnen lezen en citeren. Altijd met datum,
       steekproef, methode en het label "vraagprijs". -->
  <section class="section section--tinted" id="prijzen">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">{p.eyebrow}</p>
        <h2>{p.titel}</h2>
        <p class="section__desc">{p.intro}</p>
      </div>

      <dl class="prijzen__kern">
        <div><dt>{p.bijgewerkt}</dt><dd><time datetime={marktprijzen.bijgewerkt}>{datum(marktprijzen.bijgewerkt)}</time></dd></div>
        <div><dt>{p.advertenties}</dt><dd>{getal(marktprijzen.advertenties)}</dd></div>
        <div><dt>{p.bron}</dt><dd>{vulPrijs(p.bronTekst)}</dd></div>
        <div><dt>{p.letOp}</dt><dd>{p.letOpTekst}</dd></div>
      </dl>

      <div class="compare-wrap">
        <table class="compare prijzen-tabel">
          <thead>
            <tr>
              <th scope="col">{p.kolomStad}</th>
              <th scope="col">{p.kolomType}</th>
              <th scope="col" class="num">{p.kolomMediaan}</th>
              <th scope="col" class="num">{p.kolomBereik}</th>
              <th scope="col" class="num">{p.kolomN}</th>
            </tr>
          </thead>
          <tbody>
            {prijsRijen.map((r) => (
              <tr>
                <th scope="row">{r.stad}</th>
                <td class="prijzen-tabel__type">{r.type}</td>
                <td class="num" data-label={p.kolomMediaan}><strong>{m2(r.mediaan)}</strong></td>
                <td class="num" data-label={p.kolomBereik}>{getal(r.p25)} – {getal(r.p75)}</td>
                <td class="num" data-label={p.kolomN}>{getal(r.n)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="prijzen__kop">{p.wijkenTitel}</h3>
      <p class="prijzen__sub">{vulPrijs(p.wijkenIntro)}</p>
      <div class="compare-wrap">
        <table class="compare prijzen-tabel prijzen-tabel--wijken">
          <thead>
            <tr>
              <th scope="col">{p.kolomWijk}</th>
              <th scope="col">{p.kolomStad}</th>
              <th scope="col" class="num">{p.kolomMediaan}</th>
              <th scope="col" class="num">{p.kolomN}</th>
            </tr>
          </thead>
          <tbody>
            {wijkRijen.map((w) => (
              <tr>
                <th scope="row">{w.naam}</th>
                <td class="prijzen-tabel__type">{w.stad}</td>
                <td class="num" data-label={p.kolomMediaan}><strong>{m2(w.mediaan)}</strong></td>
                <td class="num" data-label={p.kolomN}>{getal(w.n)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="prijzen__methode">
        <h3 class="prijzen__kop">{p.methodeKop}</h3>
        {p.methode.map((regel) => <p>{vulPrijs(regel)}</p>)}
      </div>
      <p style="margin-top:28px"><a href="#aanmelden" class="btn btn--primary prijzen__knop" data-doel="0">{p.knop}</a></p>
    </div>
  </section>

  <!-- WAAROM: professioneel bedrijf vs. losse tussenpersoon -->
  <section class="section">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">{t.waarom.eyebrow}</p>
        <h2 set:html={t.waarom.titel} />
        <p class="section__desc">{t.waarom.desc}</p>
      </div>
      <div class="compare-wrap">
        <table class="compare verkoop-compare">
          <thead>
            <tr><th scope="col"></th><th scope="col">{t.waarom.kolomAnders}</th><th scope="col">{t.waarom.kolomWij}</th></tr>
          </thead>
          <tbody>
            {t.waarom.rijen.map((r) => (
              <tr><th scope="row">{r.onderwerp}</th><td data-label={t.waarom.kolomAnders}>{r.anders}</td><td data-label={t.waarom.kolomWij}>{r.wij}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- WAT WIJ DOEN -->
  <section class="section section--tinted">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">{t.diensten.eyebrow}</p>
        <h2 set:html={t.diensten.titel} />
        <p class="section__desc">{t.diensten.desc}</p>
      </div>
      <div class="datacards verkoop-diensten">
        {t.diensten.items.map((d) => (
          <div class="datacard">
            <span class="datacard__ic"><Icon name={d.icon} size={24} /></span>
            <h3>{d.titel}</h3>
            <p>{d.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NETWERK: kopers in Marokko én daarbuiten -->
  <section class="section section--dark">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow eyebrow--light">{t.netwerk.eyebrow}</p>
          <h2 set:html={t.netwerk.titel} />
          <p class="netwerk__tekst">{t.netwerk.p1}</p>
          <p class="netwerk__tekst">{t.netwerk.p2}</p>
        </div>
        <div>
          <ul class="checks netwerk__lijst">
            {t.netwerk.punten.map((p) => <li><strong>{p.kop}</strong> {p.tekst}</li>)}
          </ul>
          <div class="quote-block netwerk__transparant">
            <p><strong>{t.netwerk.transparant.kop}</strong> {t.netwerk.transparant.tekst}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WERKWIJZE -->
  <section class="section">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">{t.werkwijze.eyebrow}</p>
        <h2>{t.werkwijze.titel}</h2>
        <p class="section__desc">{t.werkwijze.desc}</p>
      </div>
      <ol class="stappen stappen--5">
        {t.werkwijze.stappen.map((s, i) => (
          <li class="stap">
            <span class="stap__num">{t.werkwijze.stap} {i + 1}</span>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CASE -->
  <section class="section section--tinted" id="case">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">{t.case.eyebrow}</p>
        <h2>{t.case.titel}<br /><em>{t.case.em}</em></h2>
        {verkoopcase.voorbeeld && <p class="case__label">{t.case.label}</p>}
      </div>

      {caseFotos.length > 0 ? (
        <ProjectGallery fotos={caseFotos} projectNaam={t.case.titel} taal={taal} lazy />
      ) : (
        <div class="pgallery" aria-label={t.case.galerij}>
          <div class="pgallery__main foto-leeg"><span>{t.case.fotoVolgt} · {t.case.legeVakken[0]}</span></div>
          <div class="pgallery__thumbs">
            {t.case.legeVakken.slice(1).map((v) => <div class="pgallery__thumb foto-leeg"><span>{v}</span></div>)}
          </div>
        </div>
      )}

      <div class="project__lead case__lead">
        <div>
          <h3 class="case__kop">{t.case.situatieKop}</h3>
          <p class="case__tekst">{t.case.situatie}</p>

          <h3 class="case__kop">{t.case.aanpakKop}</h3>
          <ol class="case__aanpak">
            {t.case.aanpak.map((a) => (
              <li><strong>{a.titel}.</strong> {a.tekst}</li>
            ))}
          </ol>

          <h3 class="case__kop">{t.case.eigenaarKop}</h3>
          <p class="case__tekst">{t.case.eigenaar}</p>
        </div>

        <aside>
          <dl class="project__specs">
            <div class="project__spec"><dt>{t.case.locatie}</dt><dd>{t.case.locatieWaarde}</dd></div>
            {t.case.specs.map((s) => (
              <div class="project__spec"><dt>{s.label}</dt><dd>{s.waarde}</dd></div>
            ))}
          </dl>
          {verkoopcase.video ? (
            <video class="case__video" src={verkoopcase.video} controls preload="none" playsinline></video>
          ) : (
            <div class="case__video foto-leeg"><span>{t.case.videoVolgt}</span></div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <Faq items={faqs} title={t.faqTitel} />

  {/* De gidsen hieronder bestaan alleen in het Nederlands. */}
  {isNl && (
    <VerderLezen items={[
      { label: 'Verkopen vanuit het buitenland', href: '/huis-verkopen-marokko-vanuit-nederland/', tekst: 'Wat er komt kijken als u buiten Marokko woont.' },
      { label: 'Waarde van uw woning bepalen', href: '/waarde-woning-marokko-bepalen/', tekst: 'Hoe een realistische vraagprijs tot stand komt.' },
      { label: 'Juridische documenten', href: '/juridische-documenten-vastgoed-marokko/', tekst: 'Welke stukken bij een overdracht horen.' },
      { label: 'Titre foncier', href: '/titre-foncier-marokko/', tekst: 'Wat de eigendomstitel betekent voor een koper.' },
    ]} />
  )}

  <section class="ctaband">
    <div class="container">
      <h2>{t.slot.titel}</h2>
      <p>{vul(t.slot.tekst)}</p>
      <div class="ctaband__actions">
        <a href="#aanmelden" class="btn btn--light">{t.slot.knop}</a>
        <a href={waBericht} class="btn btn--outline" style="color:var(--cream);border-color:var(--cream)">{t.slot.wa}</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ whatsapp: site.whatsapp, email: site.email, validatie: t.form.validatie, b: t.bericht }}>
    (function () {
      function val(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }

      // Knoppen naar het formulier vullen "Uw vraag" alvast in: in de hero de eerste
      // knop een waardebepaling en de tweede verkopen, elders via data-doel.
      function kiesDoel(i) { var s = document.getElementById('doel'); if (s) s.selectedIndex = i + 1; }
      document.querySelectorAll('.hero__actions a').forEach(function (a, i) {
        a.addEventListener('click', function () { kiesDoel(i); });
      });
      document.querySelectorAll('a[data-doel]').forEach(function (a) {
        a.addEventListener('click', function () { kiesDoel(Number(a.getAttribute('data-doel'))); });
      });

      function build() {
        // Telefoon verplicht, e-mail bewust niet: de meeste verkopers reageren
        // het liefst via WhatsApp.
        if (!val('naam') || !val('telefoon') || !val('stad') || !val('type') || !val('woonplaats')) {
          alert(validatie);
          return null;
        }
        var regels = [b.kop, ''];
        function voegToe(label, waarde) { if (waarde) regels.push(label + ': ' + waarde); }
        voegToe(b.doel, val('doel'));
        voegToe(b.naam, val('naam'));
        voegToe(b.telefoon, val('telefoon'));
        voegToe(b.email, val('email'));
        voegToe(b.woont, val('woonplaats'));
        regels.push('');
        voegToe(b.type, val('type'));
        voegToe(b.stad, val('stad'));
        voegToe(b.wijk, val('wijk'));
        voegToe(b.oppervlak, val('oppervlak'));
        voegToe(b.kamers, val('kamers'));
        voegToe(b.titel, val('titel'));
        voegToe(b.prijs, val('prijs'));
        if (val('bericht')) regels.push('', b.toelichting + ':', val('bericht'));
        return regels.join('\n');
      }

      // Elke aanmelding ook opslaan als lead in de CRM (zie LeadOpslag.astro). Blokkeert
      // nooit: de belofte is na hooguit 1 seconde klaar, ook als Supabase niet reageert.
      function bewaar(kanaal) {
        return window.meLead
          ? window.meLead('verkoop', document.getElementById('verkoopForm'), { kanaal: kanaal }, 1000)
          : Promise.resolve(false);
      }

      // Taalonafhankelijk voor GA4: waardebepaling of verkoop.
      function doelCode() {
        var i = document.getElementById('doel').selectedIndex;
        return i === 1 ? 'estimatie' : i === 2 ? 'verkoop' : 'onbekend';
      }

      function toonBevestiging() {
        var el = document.getElementById('bevestiging');
        el.hidden = false;
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      document.getElementById('sendWhatsapp').addEventListener('click', function () {
        var msg = build(); if (!msg) return;
        window.meTrack && window.meTrack('generate_lead', { form: 'verkoop', method: 'whatsapp', doel: doelCode() });
        bewaar('whatsapp');
        window.open('https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(msg), '_blank');
        toonBevestiging();
      });

      document.getElementById('sendMail').addEventListener('click', function () {
        var msg = build(); if (!msg) return;
        window.meTrack && window.meTrack('generate_lead', { form: 'verkoop', method: 'email', doel: doelCode() });
        var cc = val('email') ? '&cc=' + encodeURIComponent(val('email')) : '';
        var mailto = 'mailto:' + email
          + '?subject=' + encodeURIComponent(b.kop)
          + cc + '&body=' + encodeURIComponent(msg);
        // Eerst (kort) opslaan: sommige browsers breken een lopend verzoek af zodra
        // de mailapp opent.
        bewaar('email').then(function () { window.location.href = mailto; });
        toonBevestiging();
      });
    })();
  </script>
</BaseLayout>
