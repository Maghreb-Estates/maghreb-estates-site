---
// Professionele vastgoedgalerij: grote hoofdfoto + thumbnailstrook, met een
// toegankelijke lightbox (Esc/pijltjes/klik-buiten, focus keert terug). Geen
// externe library — alleen astro:assets voor de beeldoptimalisatie en een klein
// inline script. De hoofdfoto is het LCP-beeld en laadt daarom eager.
//
// Vaste beeldverhoudingen (16:10 hoofdfoto, 1:1 thumbs) via aspect-ratio, zodat
// er geen layout shift optreedt ongeacht de bronafmetingen.
import { Image, getImage } from 'astro:assets';
import type { ProjectFoto } from '../data/projecten';
import { standaardTaal, type Taal } from '../i18n/config';
import { aanbodUi } from '../i18n/aanbod';

interface Props { fotos: ProjectFoto[]; projectNaam: string; taal?: Taal }
const { fotos, projectNaam, taal = standaardTaal } = Astro.props;
const ui = aanbodUi[taal];

// Full-size webp voor in de lightbox (los van de kleinere grid-varianten).
const full = await Promise.all(
  fotos.map((f) => getImage({ src: f.src, width: 1600, format: 'webp' })),
);
const lightboxData = fotos.map((f, i) => ({ src: full[i].src, alt: f.alt }));

const [hoofd, ...rest] = fotos;
const zichtbareThumbs = rest.slice(0, 4);
const extra = rest.length - zichtbareThumbs.length; // aantal achter "alle foto's"
---
<section class="pgallery" aria-label={`${ui.fotos} — ${projectNaam}`}>
  <button class="pgallery__main" type="button" data-lightbox="0" aria-label={`${hoofd.alt} — ${ui.openGalerij}`}>
    <Image
      src={hoofd.src}
      alt={hoofd.alt}
      widths={[800, 1200, 1600]}
      sizes="(max-width: 760px) 100vw, 66vw"
      loading="eager"
      fetchpriority="high"
      class="pgallery__img"
    />
    <span class="pgallery__count">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      {fotos.length} {ui.fotos}
    </span>
  </button>

  {zichtbareThumbs.length > 0 && (
    <div class="pgallery__thumbs">
      {zichtbareThumbs.map((f, i) => (
        <button class="pgallery__thumb" type="button" data-lightbox={i + 1} aria-label={`${f.alt} — ${ui.openGalerij}`}>
          <Image src={f.src} alt={f.alt} widths={[240, 480]} sizes="200px" loading="lazy" class="pgallery__img" />
          {i === zichtbareThumbs.length - 1 && extra > 0 && (
            <span class="pgallery__meer" aria-hidden="true">+{extra}</span>
          )}
        </button>
      ))}
    </div>
  )}

  <div class="pgallery__actie">
    <button class="btn btn--outline pgallery__alle" type="button" data-lightbox="0">{ui.bekijkAlleFotos}</button>
  </div>
</section>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label={`${ui.fotos} — ${projectNaam}`} hidden>
  <button class="lightbox__sluit" type="button" aria-label={ui.sluiten}>&times;</button>
  <button class="lightbox__nav lightbox__nav--vorige" type="button" aria-label={ui.vorige}>&#8249;</button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--volgende" type="button" aria-label={ui.volgende}>&#8250;</button>
</div>

<script type="application/json" id="lightbox-data" set:html={JSON.stringify(lightboxData)}></script>

<script>
  (() => {
    const box = document.getElementById('lightbox');
    const dataEl = document.getElementById('lightbox-data');
    if (!box || !dataEl) return;
    const fotos: { src: string; alt: string }[] = JSON.parse(dataEl.textContent || '[]');
    const imgEl = box.querySelector('.lightbox__img') as HTMLImageElement;
    const capEl = box.querySelector('.lightbox__caption') as HTMLElement;
    const knopVorige = box.querySelector('.lightbox__nav--vorige') as HTMLButtonElement;
    const knopVolgende = box.querySelector('.lightbox__nav--volgende') as HTMLButtonElement;
    let index = 0;
    let opener: HTMLElement | null = null;

    const toon = (i: number) => {
      index = (i + fotos.length) % fotos.length;
      imgEl.src = fotos[index].src;
      imgEl.alt = fotos[index].alt;
      capEl.textContent = `${fotos[index].alt} — ${index + 1}/${fotos.length}`;
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      toon(i);
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      (box.querySelector('.lightbox__sluit') as HTMLButtonElement).focus();
    };
    const sluit = () => {
      box.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    };

    document.querySelectorAll('[data-lightbox]').forEach((el) => {
      el.addEventListener('click', () =>
        open(Number((el as HTMLElement).dataset.lightbox), el as HTMLElement),
      );
    });
    knopVorige.addEventListener('click', () => toon(index - 1));
    knopVolgende.addEventListener('click', () => toon(index + 1));
    box.querySelector('.lightbox__sluit')!.addEventListener('click', sluit);
    box.addEventListener('click', (e) => { if (e.target === box) sluit(); });
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') sluit();
      else if (e.key === 'ArrowLeft') toon(index - 1);
      else if (e.key === 'ArrowRight') toon(index + 1);
    });
  })();
</script>
