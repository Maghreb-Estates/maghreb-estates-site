---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import VerderLezen from '../components/VerderLezen.astro';
import { site, waLink } from '../data/site';
import type { ProjectFoto } from '../data/projecten';
import { faqSchema, serviceSchema } from '../data/schema';

// Verkooppagina: eigenaren melden hier hun woning aan en wij nemen de verkoop
// volledig uit handen. Breder dan /huis-verkopen-marokko-vanuit-nederland/
// (de SEO-gids voor eigenaren buiten Marokko): deze pagina is de dienst zelf,
// met een case en het aanmeldformulier.
const path = '/huis-verkopen-marokko/';

// ----- CASE ------------------------------------------------------------------
// Foto's verschijnen vanzelf: zet ze in src/assets/verkopen/case/ (jpg, png of
// webp, liggend, minimaal 1600px breed). De bestandsnaam bepaalt de volgorde
// en de alt-tekst: "01-woonkamer-met-terras.jpg" wordt "Woonkamer met terras".
// Zonder foto's toont de case lege fotovakken.
//
// TODO: vervang de voorbeeldgegevens door die van het echte huis en zet
// `voorbeeld` op false. Zolang het true is, staat er "Voorbeeldcase" bij, zodat
// niemand de gegevens voor een echt object aanziet.
const verkoopcase = {
  voorbeeld: true,
  titel: 'Appartement in Tanger',
  locatie: 'Tanger',
  specs: [
    { label: 'Type', waarde: 'Appartement' },
    { label: 'Woonoppervlak', waarde: '110 m²' },
    { label: 'Slaapkamers', waarde: '3' },
    { label: 'Eigendomstitel', waarde: 'Titre foncier' },
    { label: 'Eigenaar woont in', waarde: 'Nederland' },
    { label: 'Status', waarde: 'In de verkoop' },
    { label: 'Vraagprijs', waarde: 'Op aanvraag' },
  ],
  situatie: 'De eigenaren wonen in Nederland en gebruiken het appartement nog maar een paar weken per jaar. Een eerdere verkooppoging via een losse tussenpersoon leverde vooral telefoontjes op, maar geen serieuze kopers. Er waren geen goede foto’s, de vraagprijs was niet onderbouwd en de eigenaren hoorden soms weken niets.',
  aanpak: [
    { titel: 'Waardebepaling', tekst: 'We legden het appartement naast vergelijkbaar aanbod in dezelfde wijk uit onze marktdata. Zo kwam er een vraagprijs met een onderbouwing die ook een koper overtuigt.' },
    { titel: 'Dossier op orde', tekst: 'Titre foncier, plattegrond en de stukken van de syndicus gecontroleerd voordat de woning in de verkoop ging.' },
    { titel: 'Fotoshoot en video', tekst: 'Een professionele fotoshoot bij daglicht en een video-rondleiding, zodat een koper in het buitenland de woning echt kan beoordelen.' },
    { titel: 'Presentatie in vier talen', tekst: 'Eén verkoopbrochure en advertentie in het Nederlands, Frans, Engels en Arabisch.' },
    { titel: 'Kopers bereiken', tekst: 'Gedeeld met ons netwerk in Nederland, België en Frankrijk, en geplaatst op de grote Marokkaanse portals.' },
    { titel: 'Bezichtigingen', tekst: 'Ter plaatse door ons, en live per videogesprek voor kopers die (nog) niet in Marokko zijn.' },
  ],
  eigenaar: 'Eén kennismakingsgesprek, de verkoopopdracht tekenen en een volmacht voor de notaris. Voor de rest hoeven de eigenaren niet naar Marokko te reizen.',
  // Pad naar een mp4 in public/, bv. '/video/case-tanger.mp4'. Leeg = vak "Video-rondleiding volgt".
  video: '',
};

const fotoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/verkopen/case/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const altUitBestand = (pad: string, i: number) => {
  const naam = pad.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/^[\d\s._-]+/, '').replace(/[-_]+/g, ' ').trim();
  return naam ? naam.charAt(0).toUpperCase() + naam.slice(1) : `${verkoopcase.titel}, foto ${i + 1}`;
};
const caseFotos: ProjectFoto[] = Object.keys(fotoModules)
  .sort()
  .map((pad, i) => ({ src: fotoModules[pad].default, alt: altUitBestand(pad, i) }));
const legeVakken = ['Woonkamer', 'Keuken', 'Slaapkamer', 'Badkamer', 'Uitzicht'];

// ----- PAGINA-INHOUD ---------------------------------------------------------
const vergelijking = [
  { onderwerp: 'Presentatie', anders: 'Een paar foto’s met de telefoon en een korte advertentie.', wij: 'Professionele foto’s, een video-rondleiding en een complete verkoopbrochure.' },
  { onderwerp: 'Vraagprijs', anders: 'Een inschatting op gevoel, of de prijs die de buren vragen.', wij: 'Onderbouwd met marktdata en vergelijkbare woningen in uw wijk.' },
  { onderwerp: 'Kopers', anders: 'Vooral lokaal, via de eigen kring en Avito.', wij: 'Lokaal én internationaal, via ons netwerk van kopers in Europa.' },
  { onderwerp: 'Contact', anders: 'Wisselende personen, vaak alleen telefonisch.', wij: 'Eén vast aanspreekpunt en vaste updates per WhatsApp of e-mail.' },
  { onderwerp: 'Talen', anders: 'Meestal alleen Darija of Frans.', wij: 'Nederlands, Frans, Engels, Arabisch/Darija en Amazigh.' },
  { onderwerp: 'Dossier', anders: 'Wordt pas bij de notaris bekeken.', wij: 'Gecontroleerd voordat de woning in de verkoop gaat.' },
  { onderwerp: 'Afspraken', anders: 'Mondeling. Wie wat betaalt is vaak onduidelijk.', wij: 'Een schriftelijke verkoopopdracht met een vooraf vastgelegde vergoeding.' },
];

const diensten = [
  { icon: 'grafiek', titel: 'Waardebepaling met marktdata', tekst: 'Wij vergelijken uw woning met het actuele aanbod: elke week ruim 60.000 advertenties van de grote Marokkaanse portals. U krijgt een vraagprijs met onderbouwing.' },
  { icon: 'titel', titel: 'Dossier op orde', tekst: 'Eigendomstitel, plattegrond, syndicus en de stukken die een koper en de notaris vragen. Gecontroleerd vóór de verkoop, niet erna.' },
  { icon: 'camera', titel: 'Foto’s en video', tekst: 'Een professionele fotoshoot, een video-rondleiding en waar nodig een plattegrond. Uw woning zoals een koper hem wil zien.' },
  { icon: 'taal', titel: 'Presentatie in vier talen', tekst: 'Een verkoopbrochure en advertenties in het Nederlands, Frans, Engels en Arabisch, op de portals en in ons eigen netwerk.' },
  { icon: 'chat', titel: 'Al het klantcontact', tekst: 'Wij beantwoorden elke vraag, filteren de serieuze kopers eruit en houden u op de hoogte. U krijgt geen telefoontjes van onbekenden.' },
  { icon: 'sleutel', titel: 'Bezichtigingen', tekst: 'Ter plaatse door ons of een vaste lokale partner, en live per videogesprek voor kopers in het buitenland.' },
  { icon: 'weegschaal', titel: 'Onderhandeling', tekst: 'Wij voeren de gesprekken namens u en leggen elk bod met onze inschatting aan u voor. U beslist.' },
  { icon: 'notaris', titel: 'Notaris en overdracht', tekst: 'Wij begeleiden het traject tot en met de akte. Met een volmacht hoeft u daarvoor niet naar Marokko te komen.' },
];

const stappen = [
  { titel: 'Woning aanmelden', tekst: 'Via het formulier op deze pagina of WhatsApp. U hoort binnen 24 uur van ons.' },
  { titel: 'Kennismaking en waardebepaling', tekst: 'Wij bespreken uw situatie, bekijken het dossier en adviseren een vraagprijs met onderbouwing.' },
  { titel: 'Fotoshoot en presentatie', tekst: 'Foto’s, video en verkoopbrochure. Daarna gaat de woning de markt op, lokaal en internationaal.' },
  { titel: 'Kopers en bezichtigingen', tekst: 'Wij voeren alle gesprekken, plannen bezichtigingen en houden u op de hoogte van elke reactie.' },
  { titel: 'Onderhandeling en notaris', tekst: 'Een bod dat u accepteert, begeleiden wij tot en met de akte bij de notaris.' },
];

const faqs = [
  { q: 'Wat kost het om mijn woning via Maghreb Estates te verkopen?', a: 'Dat hangt af van de woning en van wat u uit handen geeft. U ontvangt vooraf een schriftelijk voorstel met de vergoeding en wat daaronder valt. Wij beginnen pas als u daarmee akkoord bent.' },
  { q: 'Moet ik zelf in Marokko zijn?', a: 'Nee. Wij regelen de fotoshoot, de bezichtigingen en het contact met kopers ter plaatse. Voor de akte bij de notaris kunt u een volmacht geven, zodat u ook voor de overdracht niet hoeft te reizen.' },
  { q: 'Mijn woning heeft geen titre foncier. Kan ik toch verkopen?', a: 'Vaak wel, maar het vraagt meer voorbereiding. Bij een woning met een melkia of een lopende réquisition bekijken wij eerst wat er nodig is en wat dat betekent voor de prijs en voor het soort koper. Dat bespreken wij eerlijk met u voordat de woning in de verkoop gaat.' },
  { q: 'Hoe snel is mijn woning verkocht?', a: 'Dat hangt af van prijs, locatie, staat en dossier. Wij beloven geen termijn. Wel een realistische vraagprijs, een presentatie die serieuze kopers trekt en vaste updates over reacties en bezichtigingen.' },
  { q: 'Jullie begeleiden ook kopers. Is dat geen belangenconflict?', a: 'Wij zijn daar open over. Brengen wij een koper aan die wij ook begeleiden, dan melden wij dat vooraf aan beide partijen en leggen wij schriftelijk vast voor wie wij werken en wie ons betaalt.' },
  { q: 'In welke steden werken jullie?', a: 'Vooral in Tanger, Casablanca, Rabat, Marrakech, Agadir, Nador en Al Hoceima. Ligt uw woning ergens anders? Neem gerust contact op, dan kijken wij of wij het goed kunnen doen.' },
];
---
<BaseLayout
  title="Huis verkopen in Marokko: wij nemen het uit handen | Maghreb Estates"
  description="Verkoop uw woning in Marokko via een professioneel bedrijf. Waardebepaling met marktdata, professionele foto's en video, al het klantcontact en kopers in heel Europa. Tot en met de notaris."
  path={path}
  schema={[faqSchema(faqs), serviceSchema({ naam: 'Woning verkopen in Marokko', beschrijving: 'Volledige verkoopbegeleiding van woningen in Marokko: waardebepaling, fotografie en video, presentatie, klantcontact, bezichtigingen, onderhandeling en overdracht bij de notaris.', path })]}
>
  <Hero
    eyebrow="Woning verkopen"
    title="Uw woning in Marokko verkopen?<br /><em>Wij nemen het volledig uit handen</em>"
    sub="Van de waardebepaling en de fotoshoot tot de akte bij de notaris. U werkt met één professioneel bedrijf in plaats van een willekeurige tussenpersoon, en wij bereiken kopers in heel Europa."
    image="/images/residentie-appartementen.webp"
    ctas={[
      { label: 'Meld uw woning aan', href: '#aanmelden', primary: true },
      { label: 'Bekijk een case', href: '#case' },
    ]}
    trust={['Professionele foto’s en video', 'Kopers in Europa en Marokko', 'Eén vast aanspreekpunt', 'Tot en met de notaris']}
  />
  <Breadcrumbs items={[{ label: 'Woning verkopen', href: path }]} />

  <!-- WAAROM: professioneel bedrijf vs. losse tussenpersoon -->
  <section class="section" style="padding-top:48px">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">Waarom Maghreb Estates</p>
        <h2>Een professioneel bedrijf,<br /><em>geen willekeurige tussenpersoon</em></h2>
        <p class="section__desc">Veel woningen in Marokko worden verkocht via een losse tussenpersoon of een advertentie op Avito. Dat kan goed gaan, maar vaak blijft de woning maanden staan: de foto’s overtuigen niet, de prijs is niet onderbouwd en u weet niet wie er met kopers praat. Bij ons ligt de hele verkoop bij één bedrijf dat u kunt aanspreken.</p>
      </div>
      <div class="compare-wrap">
        <table class="compare verkoop-compare">
          <thead>
            <tr><th scope="col"></th><th scope="col">Losse tussenpersoon</th><th scope="col">Maghreb Estates</th></tr>
          </thead>
          <tbody>
            {vergelijking.map((r) => (
              <tr><th scope="row">{r.onderwerp}</th><td data-label="Losse tussenpersoon">{r.anders}</td><td data-label="Maghreb Estates">{r.wij}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- WAT WIJ DOEN -->
  <section class="section section--tinted">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">Volledig uit handen</p>
        <h2>Alles wat nodig is om<br /><em>uw woning te verkopen</em></h2>
        <p class="section__desc">U geeft de verkoop aan ons over en houdt zelf de beslissingen. Wij doen het werk ertussen.</p>
      </div>
      <div class="datacards verkoop-diensten">
        {diensten.map((d) => (
          <div class="datacard">
            <span class="datacard__ic"><Icon name={d.icon} size={24} /></span>
            <h3>{d.titel}</h3>
            <p>{d.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NETWERK BUITEN MAROKKO -->
  <section class="section section--dark">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow eyebrow--light">Ons netwerk</p>
          <h2>Kopers die een gewone<br /><em>tussenpersoon niet bereikt</em></h2>
          <p class="netwerk__tekst">Een groot deel van de kopers van Marokkaans vastgoed woont niet in Marokko. Marokkanen in Nederland, België, Frankrijk en de rest van Europa zoeken een woning voor de vakantie, voor later of als investering. Zij scrollen niet door lokale advertenties en kopen niet van iemand die ze niet kennen.</p>
          <p class="netwerk__tekst">Wij hebben veel contacten buiten Marokko. Daarmee bereiken wij voor u een groep kopers die een particuliere verkoper of een lokale makelaar niet bereikt.</p>
        </div>
        <div>
          <ul class="checks netwerk__lijst">
            <li><strong>Marokkaanse Nederlanders en Belgen</strong> die een tweede woning of een woning voor later zoeken.</li>
            <li><strong>Europese kopers en investeerders</strong> die via onze aankoopbegeleiding een woning zoeken.</li>
            <li><strong>In hun eigen taal,</strong> met video en een compleet dossier, zodat zij op afstand durven te beslissen.</li>
            <li><strong>Plus de lokale markt:</strong> uw woning staat ook op de grote Marokkaanse portals.</li>
          </ul>
          <div class="quote-block netwerk__transparant">
            <p><strong>Transparant over onze rol.</strong> Brengen wij een koper aan die wij ook begeleiden, dan zeggen wij dat vooraf tegen beide partijen. Schriftelijk, met wie ons betaalt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WERKWIJZE -->
  <section class="section">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">Werkwijze</p>
        <h2>Zo verloopt de verkoop</h2>
        <p class="section__desc">Vijf stappen, met één aanspreekpunt van het eerste gesprek tot de overdracht.</p>
      </div>
      <ol class="stappen stappen--5">
        {stappen.map((s, i) => (
          <li class="stap">
            <span class="stap__num">Stap {i + 1}</span>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CASE -->
  <section class="section section--tinted" id="case">
    <div class="container">
      <div class="section__header" style="max-width:820px">
        <p class="eyebrow">Case</p>
        <h2>{verkoopcase.titel}<br /><em>van stilstand naar een sterke presentatie</em></h2>
        {verkoopcase.voorbeeld && <p class="case__label">Voorbeeldcase · gegevens en foto’s volgen</p>}
      </div>

      {caseFotos.length > 0 ? (
        <ProjectGallery fotos={caseFotos} projectNaam={verkoopcase.titel} lazy />
      ) : (
        <div class="pgallery" aria-label="Fotovakken voor de case">
          <div class="pgallery__main foto-leeg"><span>Foto volgt · {legeVakken[0]}</span></div>
          <div class="pgallery__thumbs">
            {legeVakken.slice(1).map((v) => <div class="pgallery__thumb foto-leeg"><span>{v}</span></div>)}
          </div>
        </div>
      )}

      <div class="project__lead case__lead">
        <div>
          <h3 class="case__kop">De situatie</h3>
          <p class="case__tekst">{verkoopcase.situatie}</p>

          <h3 class="case__kop">Wat wij deden</h3>
          <ol class="case__aanpak">
            {verkoopcase.aanpak.map((a) => (
              <li><strong>{a.titel}.</strong> {a.tekst}</li>
            ))}
          </ol>

          <h3 class="case__kop">Wat de eigenaren zelf deden</h3>
          <p class="case__tekst">{verkoopcase.eigenaar}</p>
        </div>

        <aside>
          <dl class="project__specs">
            <div class="project__spec"><dt>Locatie</dt><dd>{verkoopcase.locatie}</dd></div>
            {verkoopcase.specs.map((s) => (
              <div class="project__spec"><dt>{s.label}</dt><dd>{s.waarde}</dd></div>
            ))}
          </dl>
          {verkoopcase.video ? (
            <video class="case__video" src={verkoopcase.video} controls preload="none" playsinline></video>
          ) : (
            <div class="case__video foto-leeg"><span>Video-rondleiding volgt</span></div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <!-- AANMELDEN -->
  <section class="section" id="aanmelden">
    <div class="container">
      <div class="split">
        <div class="split__text">
          <p class="eyebrow">Woning aanmelden</p>
          <h2>Meld uw woning aan</h2>
          <p class="section__desc" style="margin-bottom:24px">Vertel ons kort over de woning. Wij nemen binnen 24 uur contact op voor een kennismaking. Aanmelden is vrijblijvend: u zit nergens aan vast tot u een verkoopopdracht tekent.</p>

          <ul class="checks" style="margin-bottom:28px">
            <li>Vrijblijvende kennismaking en eerste prijsindicatie</li>
            <li>Vergoeding vooraf schriftelijk vastgelegd</li>
            <li>Ook als u buiten Marokko woont</li>
            <li>In het Nederlands, Frans, Engels, Arabisch/Darija of Amazigh</li>
          </ul>

          <div class="feature">
            <h3>Liever direct contact?</h3>
            <ul class="contactlist">
              <li><Icon name="whatsapp" size={18} /><a href={waLink('Hallo Maghreb Estates, ik wil mijn woning in Marokko verkopen.')} style="color:var(--green-mid)">WhatsApp ons</a></li>
              <li><Icon name="telefoon" size={18} /><a href={`tel:${site.telefoonHref}`} style="color:var(--green-mid)">{site.telefoon}</a></li>
              <li><Icon name="mail" size={18} /><a href={`mailto:${site.email}`} style="color:var(--green-mid)">{site.email}</a></li>
            </ul>
          </div>
        </div>

        <form class="card" id="verkoopForm" novalidate>
          <div class="veld">
            <label for="naam">Naam <span aria-hidden="true">*</span></label>
            <input type="text" id="naam" name="naam" placeholder="Uw volledige naam" required />
          </div>
          <div class="veld">
            <label for="telefoon">Telefoon / WhatsApp <span aria-hidden="true">*</span></label>
            <input type="tel" id="telefoon" name="telefoon" placeholder="+31 6 … of +212 6 …" required />
          </div>
          <div class="veld">
            <label for="email">E-mailadres <span class="veld__hint">(optioneel)</span></label>
            <input type="email" id="email" name="email" placeholder="uw@email.com" />
          </div>
          <div class="veld">
            <label for="woonplaats">Waar woont u? <span aria-hidden="true">*</span></label>
            <select id="woonplaats" name="woonplaats" required>
              <option value="">Selecteer een optie</option>
              <option>In Marokko</option>
              <option>In Nederland</option>
              <option>In België</option>
              <option>Elders in Europa</option>
              <option>Elders</option>
            </select>
          </div>
          <div class="veld">
            <label for="type">Type woning <span aria-hidden="true">*</span></label>
            <select id="type" name="type" required>
              <option value="">Selecteer een optie</option>
              <option>Appartement</option>
              <option>Villa</option>
              <option>Huis / dar</option>
              <option>Riad</option>
              <option>Grond</option>
              <option>Bedrijfspand</option>
              <option>Anders</option>
            </select>
          </div>
          <div class="veld">
            <label for="stad">Stad en wijk <span aria-hidden="true">*</span></label>
            <input type="text" id="stad" name="stad" placeholder="Bijv. Tanger, Malabata" required />
          </div>
          <div class="veld-rij">
            <div class="veld">
              <label for="oppervlak">Oppervlakte <span class="veld__hint">(m², optioneel)</span></label>
              <input type="text" id="oppervlak" name="oppervlak" inputmode="numeric" placeholder="Bijv. 110" />
            </div>
            <div class="veld">
              <label for="kamers">Slaapkamers <span class="veld__hint">(optioneel)</span></label>
              <input type="text" id="kamers" name="kamers" inputmode="numeric" placeholder="Bijv. 3" />
            </div>
          </div>
          <div class="veld">
            <label for="titel">Eigendomstitel <span class="veld__hint">(optioneel)</span></label>
            <select id="titel" name="titel">
              <option value="">Weet ik niet</option>
              <option>Titre foncier</option>
              <option>Melkia</option>
              <option>Réquisition (in behandeling)</option>
            </select>
          </div>
          <div class="veld">
            <label for="prijs">Gewenste vraagprijs <span class="veld__hint">(optioneel)</span></label>
            <input type="text" id="prijs" name="prijs" placeholder="Bijv. 1.500.000 MAD of € 140.000" />
          </div>
          <div class="veld">
            <label for="bericht">Toelichting <span class="veld__hint">(optioneel)</span></label>
            <textarea id="bericht" name="bericht" rows="4" placeholder="Staat van de woning, verdieping, uitzicht, wanneer u wilt verkopen…"></textarea>
          </div>

          <div class="form__acties">
            <button type="button" id="sendWhatsapp" class="btn btn--primary">Via WhatsApp</button>
            <button type="button" id="sendMail" class="btn btn--outline">Via e-mail</button>
          </div>

          <p class="form__melding" id="bevestiging" hidden>
            Bedankt voor uw aanmelding bij Maghreb Estates. Wij nemen binnen 24 uur contact met u op voor een kennismaking. Heeft u al foto’s of documenten van de woning? Die kunt u in hetzelfde WhatsApp- of e-mailgesprek meesturen.
          </p>
        </form>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Veelgestelde vragen over verkopen" />

  <VerderLezen items={[
    { label: 'Verkopen vanuit Nederland', href: '/huis-verkopen-marokko-vanuit-nederland/', tekst: 'Wat er komt kijken als u buiten Marokko woont.' },
    { label: 'Waarde van uw woning bepalen', href: '/waarde-woning-marokko-bepalen/', tekst: 'Hoe een realistische vraagprijs tot stand komt.' },
    { label: 'Juridische documenten', href: '/juridische-documenten-vastgoed-marokko/', tekst: 'Welke stukken bij een overdracht horen.' },
    { label: 'Titre foncier', href: '/titre-foncier-marokko/', tekst: 'Wat de eigendomstitel betekent voor een koper.' },
  ]} />

  <section class="ctaband">
    <div class="container">
      <h2>Klaar om uw woning te verkopen?</h2>
      <p>Meld uw woning aan of stuur ons een WhatsApp. Wij nemen binnen 24 uur contact op.</p>
      <div class="ctaband__actions">
        <a href="#aanmelden" class="btn btn--light">Meld uw woning aan</a>
        <a href={waLink('Hallo Maghreb Estates, ik wil mijn woning in Marokko verkopen.')} class="btn btn--outline" style="color:var(--cream);border-color:var(--cream)">WhatsApp ons</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ whatsapp: site.whatsapp, email: site.email }}>
    (function () {
      function val(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }

      function build() {
        // Telefoon verplicht, e-mail bewust niet: de meeste verkopers reageren
        // het liefst via WhatsApp.
        if (!val('naam') || !val('telefoon') || !val('woonplaats') || !val('type') || !val('stad')) {
          alert('Vul uw naam, telefoonnummer, woonplaats, type woning en stad in.');
          return null;
        }
        var regels = ['Woning aangemeld via maghreb-estates.com', ''];
        function voegToe(label, waarde) { if (waarde) regels.push(label + ': ' + waarde); }
        voegToe('Naam', val('naam'));
        voegToe('Telefoon / WhatsApp', val('telefoon'));
        voegToe('E-mail', val('email'));
        voegToe('Woont', val('woonplaats'));
        regels.push('');
        voegToe('Type woning', val('type'));
        voegToe('Stad en wijk', val('stad'));
        voegToe('Oppervlakte (m²)', val('oppervlak'));
        voegToe('Slaapkamers', val('kamers'));
        voegToe('Eigendomstitel', val('titel'));
        voegToe('Gewenste vraagprijs', val('prijs'));
        if (val('bericht')) regels.push('', 'Toelichting:', val('bericht'));
        return regels.join('\n');
      }

      function toonBevestiging() {
        var b = document.getElementById('bevestiging');
        b.hidden = false;
        b.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      document.getElementById('sendWhatsapp').addEventListener('click', function () {
        var msg = build(); if (!msg) return;
        window.meTrack && window.meTrack('generate_lead', { form: 'verkoop', method: 'whatsapp' });
        window.open('https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(msg), '_blank');
        toonBevestiging();
      });

      document.getElementById('sendMail').addEventListener('click', function () {
        var msg = build(); if (!msg) return;
        window.meTrack && window.meTrack('generate_lead', { form: 'verkoop', method: 'email' });
        var cc = val('email') ? '&cc=' + encodeURIComponent(val('email')) : '';
        window.location.href = 'mailto:' + email
          + '?subject=' + encodeURIComponent('Woning aangemeld via maghreb-estates.com')
          + cc + '&body=' + encodeURIComponent(msg);
        toonBevestiging();
      });
    })();
  </script>
</BaseLayout>
