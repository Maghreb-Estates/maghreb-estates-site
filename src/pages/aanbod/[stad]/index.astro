---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import CtaInline from '../../../components/CtaInline.astro';
import Faq from '../../../components/Faq.astro';
import LeadCta from '../../../components/LeadCta.astro';
import VerderLezen from '../../../components/VerderLezen.astro';
import { stedenMetAanbod, projectenVoorStad } from '../../../data/projecten';
import { steden } from '../../../data/steden';
import { faqSchema, serviceSchema } from '../../../data/schema';
import { aanbodAlternates } from '../../../i18n/aanbod';

export function getStaticPaths() {
  return stedenMetAanbod.map((s) => ({
    params: { stad: s.stad },
    props: { stadInfo: s, stad: steden.find((x) => x.slug === s.stad)! },
  }));
}

const { stadInfo, stad } = Astro.props;
const path = `/aanbod/${stadInfo.stad}/`;
const { alternates, xDefault } = aanbodAlternates({ soort: 'stad', stad: stadInfo.stad });
const projects = projectenVoorStad(stadInfo.stad);
const meer = projects.length === 1 ? 'dit project' : `deze ${projects.length} projecten`;

const faqs = [
  { q: `Welke projecten heeft Maghreb Estates in ${stadInfo.stadNaam}?`, a: `Wij begeleiden op dit moment ${projects.length === 1 ? 'één project' : projects.length + ' projecten'} in ${stadInfo.stadNaam}: ${projects.map((p) => p.naam).join(', ')}. Ons aanbod groeit; nieuwe projecten voegen wij toe zodra de gegevens gecontroleerd zijn.` },
  { q: `Kan ik als buitenlandse koper vastgoed kopen in ${stadInfo.stadNaam}?`, a: `Ja. Buitenlandse kopers kunnen in ${stadInfo.stadNaam} onroerend goed kopen, ook volledig op afstand. Wij controleren de eigendomstitel (titre foncier), het koopcontract en begeleiden de overdracht via de notaris.` },
  { q: `Wat is de verhuurpotentie in ${stadInfo.stadNaam}?`, a: `${stad.verhuur}` },
];
---
<BaseLayout
  title={`Vastgoed te koop in ${stadInfo.stadNaam} | Projecten | Maghreb Estates`}
  description={`Bekijk het vastgoedaanbod van Maghreb Estates in ${stadInfo.stadNaam}: ${projects.map((p) => p.naam).join(', ')}. Foto's, ligging en projectinformatie, met onafhankelijke begeleiding.`}
  path={path}
  alternates={alternates}
  xDefault={xDefault}
  schema={[
    faqSchema(faqs),
    serviceSchema({ naam: `Vastgoedaanbod ${stadInfo.stadNaam}`, beschrijving: `Vastgoedprojecten in ${stadInfo.stadNaam}, met begeleiding bij aankoop, dossiercontrole en overdracht.`, path }),
  ]}
>
  <Hero
    compact
    eyebrow={`Aanbod in ${stad.regio}`}
    title={`Vastgoed te koop<br /><em>in ${stadInfo.stadNaam}</em>`}
    sub={`${stad.invalshoek} Bekijk ${meer} die wij in ${stadInfo.stadNaam} begeleiden.`}
    image="/images/villa4.jpg"
    ctas={[
      { label: 'Plan adviesgesprek', href: '/adviesgesprek/', primary: true },
      { label: 'Laat een object beoordelen', href: '/contact/?doel=objectanalyse' },
    ]}
  />
  <Breadcrumbs items={[
    { label: 'Aanbod', href: '/aanbod/' },
    { label: stadInfo.stadNaam, href: path },
  ]} />

  <section class="section">
    <div class="container prose" style="max-width:760px">
      <p>{stad.intro}</p>
      <p>Hieronder vindt u de projecten die wij op dit moment in {stadInfo.stadNaam} begeleiden. Wilt u meer weten over de lokale markt, prijzen en verhuurpotentie? Lees dan onze achtergrondpagina <a href={`/vastgoed-${stad.slug}/`}>vastgoed kopen in {stadInfo.stadNaam}</a>.</p>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="section__header section__header--center">
        <p class="eyebrow">Projecten</p>
        <h2>Aanbod in <em>{stadInfo.stadNaam}</em></h2>
      </div>
      <div class="aanbod-grid">
        {projects.map((p, i) => (
          <div class="aanbod-grid__item">
            <ProjectCard project={p} headingLevel={3} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 360px" eager={i === 0} />
          </div>
        ))}
      </div>

      <CtaInline
        title={`Een specifiek object in ${stadInfo.stadNaam} op het oog?`}
        text="Ook buiten ons eigen aanbod helpen wij u. Stuur ons de link of documenten, dan controleren wij het dossier en de prijs."
        label="Stuur een object ter controle"
        href="/contact/?doel=objectanalyse"
      />
    </div>
  </section>

  <Faq items={faqs} title={`Veelgestelde vragen over vastgoed in ${stadInfo.stadNaam}`} />

  <VerderLezen items={[
    { label: `Vastgoed kopen in ${stadInfo.stadNaam}`, href: `/vastgoed-${stad.slug}/`, tekst: 'Achtergrond over de lokale markt, prijzen en verhuur.' },
    { label: 'Alle projecten', href: '/aanbod/', tekst: 'Bekijk ons volledige vastgoedaanbod in Marokko.' },
    { label: 'Aankoopbegeleiding', href: '/aankoopbegeleiding-vastgoed-marokko/', tekst: 'Selectie, due diligence en overdracht.' },
    { label: 'Investeringsadvies', href: '/investeren-vastgoed-marokko/', tekst: 'Netto rendement en strategie, onderbouwd met marktdata.' },
  ]} />

  <LeadCta path={path} />
</BaseLayout>
